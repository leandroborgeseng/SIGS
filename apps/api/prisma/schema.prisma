generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Facility {
  id        String   @id @default(uuid())
  cnes      String
  name      String
  active    Boolean  @default(true)
  cnpj      String?
  typeId    String?  @map("type_id")
  /// Código IBGE do município (7 dígitos) — header LEDI codigoIbgeMunicipio
  ibgeCode  String?  @map("ibge_code")
  createdAt DateTime @default(now()) @map("created_at")
  teams     Team[]
  encounters Encounter[]
  vaccinations VaccinationRecord[]
  vaccinationStockLots VaccinationStockLot[]
  vaccinationColdEquipments VaccinationColdEquipment[]
  vaccinationThermalBoxes VaccinationThermalBox[]
  vaccinationTempReadings VaccinationTempReading[]
  vaccinationSupplies VaccinationSupply[]
  dentalEncounters DentalEncounter[]
  homeCareVisits HomeCareVisit[]
  acsHomeVisits AcsHomeVisit[]
  collectiveActivities CollectiveActivity[]
  appointmentSlots AppointmentSlot[]
  queueTickets QueueTicket[]
  prescriptions Prescription[]
  regulationRequests RegulationRequest[]
  assignments ProfessionalAssignment[]

  @@index([cnes])
  @@index([active])
  @@map("facilities")
}

model Professional {
  id         String   @id @default(uuid())
  civilName  String   @map("civil_name")
  socialName String?  @map("social_name")
  cpf        String?
  cns        String?
  createdAt  DateTime @default(now()) @map("created_at")
  slots      AppointmentSlot[]
  encounters Encounter[]
  vaccinations VaccinationRecord[]
  dentalEncounters DentalEncounter[]
  homeCareVisits HomeCareVisit[]
  acsHomeVisits AcsHomeVisit[]
  collectiveActivities CollectiveActivity[]
  queueTickets QueueTicket[]
  prescriptions Prescription[]
  regulationRequests RegulationRequest[]
  assignments ProfessionalAssignment[]

  @@map("professionals")
}

model Team {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  name       String
  teamTypeId String   @map("team_type_id")
  active     Boolean  @default(true)
  ine        String?
  createdAt  DateTime @default(now()) @map("created_at")

  facility   Facility @relation(fields: [facilityId], references: [id])
  microAreas MicroArea[]
  links      PatientTeamLink[]
  households Household[]
  acsHomeVisits AcsHomeVisit[]
  assignments ProfessionalAssignment[]

  @@map("teams")
}

/// Lotação do profissional na unidade (RF-2.2 / RF-2.60)
model ProfessionalAssignment {
  id             String    @id @default(uuid())
  professionalId String    @map("professional_id")
  facilityId     String    @map("facility_id")
  teamId         String?   @map("team_id")
  /// CBO ocupação (ex.: 225125)
  cbo            String
  roleLabel      String?   @map("role_label")
  active         Boolean   @default(true)
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  professional Professional @relation(fields: [professionalId], references: [id])
  facility     Facility     @relation(fields: [facilityId], references: [id])
  team         Team?        @relation(fields: [teamId], references: [id])

  @@index([facilityId, active])
  @@index([professionalId, active])
  @@map("professional_assignments")
}

model Patient {
  id                 String    @id @default(uuid())
  civilName          String    @map("civil_name")
  socialName         String?   @map("social_name")
  cpf                String?
  cns                String?
  birthDate          DateTime  @map("birth_date")
  sex                String
  raceColor          String?   @map("race_color")
  motherName         String?   @map("mother_name")
  motherNameUnknown  Boolean   @default(false) @map("mother_name_unknown")
  fatherName         String?   @map("father_name")
  fatherNameUnknown  Boolean   @default(false) @map("father_name_unknown")
  isDeceased         Boolean   @default(false) @map("is_deceased")
  deathDate          DateTime? @map("death_date")
  deathCertificate   String?   @map("death_certificate")
  phone              String?
  notes              String?
  addressStreet      String?   @map("address_street")
  addressNumber      String?   @map("address_number")
  addressComplement  String?   @map("address_complement")
  addressNeighborhood String?  @map("address_neighborhood")
  addressCity        String?   @map("address_city")
  addressState       String?   @map("address_state")
  addressZip         String?   @map("address_zip")
  /// BRASILEIRA | NATURALIZADA | ESTRANGEIRA — RF-2.30 CDS
  nationality        String?   @map("nationality")
  /// IBGE município de nascimento (brasileiro)
  birthMunicipalityIbge String? @map("birth_municipality_ibge")
  /// Etnia (quando raça/cor indígena)
  ethnicity          String?   @map("ethnicity")
  hasDisability      Boolean   @default(false) @map("has_disability")
  /// JSON array de códigos de deficiência CDS
  disabilityCodesJson String  @default("[]") @map("disability_codes_json")
  email              String?
  /// NIS/PIS/PASEP 11 dígitos
  nis                String?
  educationLevel     String?   @map("education_level")
  /** false = unificado em outro Paciente Mestre */
  active             Boolean   @default(true)
  mergedIntoId       String?   @map("merged_into_id")
  createdAt          DateTime  @default(now()) @map("created_at")

  mergedInto Patient?  @relation("PatientMerge", fields: [mergedIntoId], references: [id])
  mergedFrom Patient[] @relation("PatientMerge")

  links PatientTeamLink[]
  familyMemberships FamilyMember[]
  familiesAsResponsible HouseholdFamily[] @relation("FamilyResponsible")
  slots AppointmentSlot[]
  encounters Encounter[]
  vaccinations VaccinationRecord[]
  dentalEncounters DentalEncounter[]
  homeCareVisits HomeCareVisit[]
  acsHomeVisits AcsHomeVisit[]
  queueTickets QueueTicket[]
  prescriptions Prescription[]
  regulationRequests RegulationRequest[]
  identifiers PatientIdentifier[]
  matchCandidatesAsLeft PatientMatchCandidate[] @relation("MatchLeft")
  matchCandidatesAsRight PatientMatchCandidate[] @relation("MatchRight")
  matchCandidatesAsWinner PatientMatchCandidate[] @relation("MatchWinner")
  productionRecords ProductionRecord[]

  @@index([active, civilName])
  @@index([cpf])
  @@index([cns])
  @@index([mergedIntoId])
  @@map("patients")
}

model MicroArea {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  team       Team        @relation(fields: [teamId], references: [id])
  links      PatientTeamLink[]
  households Household[]
  acsHomeVisits AcsHomeVisit[]

  @@map("micro_areas")
}

model PatientTeamLink {
  id          String   @id @default(uuid())
  patientId   String   @map("patient_id")
  teamId      String   @map("team_id")
  microAreaId String?  @map("micro_area_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  patient   Patient    @relation(fields: [patientId], references: [id])
  team      Team       @relation(fields: [teamId], references: [id])
  microArea MicroArea? @relation(fields: [microAreaId], references: [id])

  @@map("patient_team_links")
}

/// Domicílio / imóvel CDS territorial (RF-2.29) — alinhado CadastroDomiciliarThrift, sem GIS
model Household {
  id               String   @id @default(uuid())
  teamId           String   @map("team_id")
  microAreaId      String?  @map("micro_area_id")
  /// LEDI tipoDeImovel (1=Domicílio, 2=Comércio, …)
  propertyType     Int      @default(1) @map("property_type")
  street           String?
  number           String?
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  zip              String?
  municipalityIbge String?  @map("municipality_ibge")
  /// CondicaoMoradiaThrift — códigos LEDI (opcionais)
  locationType     Int?     @map("location_type")
  dwellingType     Int?     @map("dwelling_type")
  ownershipStatus  Int?     @map("ownership_status")
  waterSupply      Int?     @map("water_supply")
  waterConsumption Int?     @map("water_consumption")
  sewageDisposal   Int?     @map("sewage_disposal")
  wasteDisposal    Int?     @map("waste_disposal")
  electricity      Boolean?
  roomsCount       Int?     @map("rooms_count")
  residentsCount   Int?     @map("residents_count")
  hasAnimals       Boolean  @default(false) @map("has_animals")
  animalsCount     Int?     @map("animals_count")
  refusalTerm      Boolean  @default(false) @map("refusal_term")
  active           Boolean  @default(true)
  notes            String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  team      Team               @relation(fields: [teamId], references: [id])
  microArea MicroArea?         @relation(fields: [microAreaId], references: [id])
  families  HouseholdFamily[]
  acsVisits AcsHomeVisit[]

  @@index([teamId, active])
  @@index([microAreaId])
  @@map("households")
}

/// Visita domiciliar ACS/ACE (RF-17.11 / RF-17.12) — ficha LEDI tipo 8 fields mínimos; sem lote XML
model AcsHomeVisit {
  id             String    @id @default(uuid())
  facilityId     String    @map("facility_id")
  teamId         String?   @map("team_id")
  microAreaId    String?   @map("micro_area_id")
  householdId    String?   @map("household_id")
  patientId      String?   @map("patient_id")
  professionalId String?   @map("professional_id")
  /// MANHA | TARDE | NOITE (LEDI turno)
  shift          String    @default("MANHA")
  /// LEDI DesfechoDbEnum: 1=realizada · 2=recusada · 3=ausente
  desfecho       Int
  /// JSON array de ids MotivoVisitaDbEnum
  motivosJson    String    @default("[]") @map("motivos_json")
  latitude       Float?
  longitude      Float?
  visitedAt      DateTime  @default(now()) @map("visited_at")
  notes          String?
  /// RECORDED | VOID
  status         String    @default("RECORDED")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  facility     Facility      @relation(fields: [facilityId], references: [id])
  team         Team?         @relation(fields: [teamId], references: [id])
  microArea    MicroArea?    @relation(fields: [microAreaId], references: [id])
  household    Household?    @relation(fields: [householdId], references: [id])
  patient      Patient?      @relation(fields: [patientId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([facilityId, visitedAt])
  @@index([patientId, visitedAt])
  @@index([householdId, visitedAt])
  @@map("acs_home_visits")
}

/// Família no domicílio (FamiliaRowThrift + membros locais)
model HouseholdFamily {
  id                    String    @id @default(uuid())
  householdId           String    @map("household_id")
  responsiblePatientId  String    @map("responsible_patient_id")
  membersCount          Int?      @map("members_count")
  /// Código LEDI rendaFamiliar
  householdIncomeCode   Int?      @map("household_income_code")
  residingSince         DateTime? @map("residing_since")
  prontuarioNumber      String?   @map("prontuario_number")
  active                Boolean   @default(true)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  household   Household     @relation(fields: [householdId], references: [id])
  responsible Patient       @relation("FamilyResponsible", fields: [responsiblePatientId], references: [id])
  members     FamilyMember[]

  @@index([householdId, active])
  @@index([responsiblePatientId])
  @@map("household_families")
}

model FamilyMember {
  id           String   @id @default(uuid())
  familyId     String   @map("family_id")
  patientId    String   @map("patient_id")
  /// RESPONSAVEL | CONJUGE | FILHO | OUTRO
  relationship String   @default("OUTRO")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  family  HouseholdFamily @relation(fields: [familyId], references: [id])
  patient Patient         @relation(fields: [patientId], references: [id])

  @@unique([familyId, patientId])
  @@index([patientId, active])
  @@map("family_members")
}

/// Agenda — status alinhados ao design handoff
model AppointmentSlot {
  id             String   @id @default(uuid())
  facilityId     String?  @map("facility_id")
  professionalId String   @map("professional_id")
  patientId      String?  @map("patient_id")
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  status         String   @default("SCHEDULED")
  notes          String?
  /// CONSULTA (LEDI tipoAtendimento=2) | ENCAIXE (tipoAtendimento=5)
  itemType       String   @default("CONSULTA") @map("item_type")
  /// GENERAL | ODONTO | APS — linha de cuidado para abrir ficha
  careLine       String   @default("GENERAL") @map("care_line")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  facility         Facility?        @relation(fields: [facilityId], references: [id])
  professional     Professional     @relation(fields: [professionalId], references: [id])
  patient          Patient?         @relation(fields: [patientId], references: [id])
  encounter        Encounter?
  /// Atendimento odontológico aberto a partir deste slot (RF-12.1)
  dentalEncounter  DentalEncounter?

  @@index([facilityId, startsAt])
  @@index([facilityId, careLine, startsAt])
  @@map("appointment_slots")
}

/// Totem / painel de senha (RF-3.10, RF-3.11, RF-3.23)
model QueueTicket {
  id             String    @id @default(uuid())
  facilityId     String    @map("facility_id")
  /// NORMAL | PRIORITARIO | VACINA | ODONTO | OUTRO
  serviceType    String    @default("NORMAL") @map("service_type")
  /// Ex.: N042, P003
  code           String
  seq            Int
  status         String    @default("WAITING") /// WAITING | CALLED | COMPLETED | NO_SHOW | CANCELLED
  patientId      String?   @map("patient_id")
  displayName    String?   @map("display_name")
  deskLabel      String?   @map("desk_label") /// consultório / guichê
  professionalId String?   @map("professional_id")
  encounterId    String?   @map("encounter_id")
  calledAt       DateTime? @map("called_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  facility     Facility     @relation(fields: [facilityId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([facilityId, status, createdAt])
  @@index([facilityId, createdAt])
  @@map("queue_tickets")
}

/// Atendimento APS — status da fila (design D2)
model Encounter {
  id               String    @id @default(uuid())
  patientId        String    @map("patient_id")
  facilityId       String    @map("facility_id")
  professionalId   String?   @map("professional_id")
  teamId           String?   @map("team_id")
  appointmentId    String?   @unique @map("appointment_id")
  status           String    @default("WAITING")
  startedAt        DateTime  @default(now()) @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  statusChangedAt  DateTime  @default(now()) @map("status_changed_at")
  careLocation     String?   @map("care_location")
  shift            String?
  encounterType    String?   @map("encounter_type")
  lateRegistration Boolean   @default(false) @map("late_registration")
  /// JSON clínico: SOAP, CIAP, CID, procedimentos, antropometria, outcomes
  clinicalJson     String    @default("{}") @map("clinical_json")
  productionBatchId String?  @map("production_batch_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  patient      Patient          @relation(fields: [patientId], references: [id])
  facility     Facility         @relation(fields: [facilityId], references: [id])
  professional Professional?    @relation(fields: [professionalId], references: [id])
  appointment  AppointmentSlot? @relation(fields: [appointmentId], references: [id])
  prescriptions Prescription[]
  regulationRequests RegulationRequest[]

  @@index([patientId, status])
  @@index([facilityId, status])
  @@map("encounters")
}

model VaccinationRecord {
  id                String   @id @default(uuid())
  patientId         String   @map("patient_id")
  facilityId        String   @map("facility_id")
  professionalId    String?  @map("professional_id")
  shift             String
  careLocation      String   @map("care_location")
  status            String   @default("DRAFT") // DRAFT | READY | SENT | VOID
  appliedAt         DateTime @default(now()) @map("applied_at")
  /// JSON array de aplicações (imuno, estratégia, dose, lote, flags…)
  applicationsJson  String   @map("applications_json")
  productionBatchId String?  @map("production_batch_id")
  voidReason        String?  @map("void_reason")
  voidedAt          DateTime? @map("voided_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  facility     Facility      @relation(fields: [facilityId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([patientId])
  @@map("vaccination_records")
}

/// Catálogo TB_IMUNOBIOLOGICO (seed LEDI + overlay municipal) — RF-14.1/14.2
model VaccinationImmunobiological {
  id        String   @id /// código estável SIGS (ex.: BCG)
  lediId    Int      @unique @map("ledi_id")
  code      String /// sigla LEDI
  label     String
  active    Boolean  @default(true)
  /// seed | overlay
  source    String   @default("seed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([source])
  @@index([label])
  @@map("vaccination_immunobiologicals")
}

/// Faixas etárias (seed PNI aproximado + overlay) — RF-14.7/14.8
/// Dump TB_FAIXA_ETARIA_VACINACAO e-SUS não está no repo.
model VaccinationAgeRange {
  id                 String   @id @default(uuid())
  immunobiologicalId String   @map("immunobiological_id")
  strategyId         String?  @map("strategy_id")
  minDays            Int      @map("min_days")
  maxDays            Int?     @map("max_days")
  label              String
  /// seed | overlay
  source             String   @default("seed")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([immunobiologicalId])
  @@index([source])
  @@map("vaccination_age_ranges")
}

/// Estoque vacinal por lote na unidade — RF-14.15/14.16.
/// Temperatura alvo/faixa declarada; NÃO é monitoramento contínuo de geladeira.
model VaccinationStockLot {
  id                 String    @id @default(uuid())
  facilityId         String    @map("facility_id")
  immunobiologicalId String    @map("immunobiological_id")
  /// Número do lote (mesmo charset da aplicação)
  lot                String
  manufacturer       String?
  expiresAt          DateTime? @map("expires_at")
  quantity           Int
  /// Unidade de quantidade (MVP: dose)
  unit               String    @default("dose")
  /// Faixa de temperatura alvo (°C) — declarado, sem IoT
  targetTempMinC     Float?    @map("target_temp_min_c")
  targetTempMaxC     Float?    @map("target_temp_max_c")
  /// Rótulo da sala/geladeira (texto livre)
  roomLabel          String?   @map("room_label")
  /// Equipamento frio cadastrado (RF-14.17) — opcional
  coldEquipmentId    String?   @map("cold_equipment_id")
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  facility      Facility                  @relation(fields: [facilityId], references: [id])
  coldEquipment VaccinationColdEquipment? @relation(fields: [coldEquipmentId], references: [id])
  movements     VaccinationStockMovement[]

  @@unique([facilityId, immunobiologicalId, lot])
  @@index([facilityId, active])
  @@index([immunobiologicalId])
  @@index([expiresAt])
  @@index([coldEquipmentId])
  @@map("vaccination_stock_lots")
}

/// Movimentos de estoque vacinal (entrada, baixa por aplicação, estorno void).
model VaccinationStockMovement {
  id                   String   @id @default(uuid())
  stockLotId           String   @map("stock_lot_id")
  /// ENTRY | APPLY | VOID_RETURN | ADJUST
  kind                 String
  /// Delta aplicado à quantidade (+ entrada/estorno, − baixa)
  quantityDelta        Int      @map("quantity_delta")
  vaccinationRecordId  String?  @map("vaccination_record_id")
  note                 String?
  createdAt            DateTime @default(now()) @map("created_at")

  stockLot VaccinationStockLot @relation(fields: [stockLotId], references: [id])

  @@index([stockLotId])
  @@index([vaccinationRecordId])
  @@index([kind])
  @@map("vaccination_stock_movements")
}

/// Equipamento frio (geladeira/freezer/câmara) — RF-14.17 (sem IoT).
model VaccinationColdEquipment {
  id             String   @id @default(uuid())
  facilityId     String   @map("facility_id")
  code           String
  label          String
  /// REFRIGERATOR | FREEZER | COLD_ROOM
  kind           String   @default("REFRIGERATOR")
  targetTempMinC Float    @map("target_temp_min_c")
  targetTempMaxC Float    @map("target_temp_max_c")
  /// ACTIVE | MAINTENANCE | INACTIVE
  status         String   @default("ACTIVE")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  facility     Facility                   @relation(fields: [facilityId], references: [id])
  stockLots    VaccinationStockLot[]
  thermalBoxes VaccinationThermalBox[]
  readings     VaccinationTempReading[]

  @@unique([facilityId, code])
  @@index([facilityId, active])
  @@index([status])
  @@map("vaccination_cold_equipments")
}

/// Caixa térmica — RF-14.18 (controle operacional sem sensor).
model VaccinationThermalBox {
  id              String   @id @default(uuid())
  facilityId      String   @map("facility_id")
  code            String
  label           String
  coldEquipmentId String?  @map("cold_equipment_id")
  targetTempMinC  Float?   @map("target_temp_min_c")
  targetTempMaxC  Float?   @map("target_temp_max_c")
  /// AVAILABLE | IN_USE | MAINTENANCE
  status          String   @default("AVAILABLE")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  facility      Facility                  @relation(fields: [facilityId], references: [id])
  coldEquipment VaccinationColdEquipment? @relation(fields: [coldEquipmentId], references: [id])
  readings      VaccinationTempReading[]

  @@unique([facilityId, code])
  @@index([facilityId, active])
  @@index([status])
  @@index([coldEquipmentId])
  @@map("vaccination_thermal_boxes")
}

/// Leitura manual de temperatura — RF-14.19 (não é IoT contínuo).
model VaccinationTempReading {
  id              String   @id @default(uuid())
  facilityId      String   @map("facility_id")
  coldEquipmentId String?  @map("cold_equipment_id")
  thermalBoxId    String?  @map("thermal_box_id")
  temperatureC    Float    @map("temperature_c")
  recordedAt      DateTime @default(now()) @map("recorded_at")
  withinRange     Boolean  @map("within_range")
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  facility      Facility                  @relation(fields: [facilityId], references: [id])
  coldEquipment VaccinationColdEquipment? @relation(fields: [coldEquipmentId], references: [id])
  thermalBox    VaccinationThermalBox?    @relation(fields: [thermalBoxId], references: [id])

  @@index([facilityId, recordedAt])
  @@index([coldEquipmentId])
  @@index([thermalBoxId])
  @@index([withinRange])
  @@map("vaccination_temp_readings")
}

/// Insumo vacinal leve (almoxarifado da sala) — RF-14.4/14.6 (sem farmácia geral).
model VaccinationSupply {
  id         String   @id @default(uuid())
  facilityId String   @map("facility_id")
  sku        String
  label      String
  unit       String   @default("un")
  quantity   Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  facility Facility                @relation(fields: [facilityId], references: [id])
  links    VaccinationSupplyLink[]
  movements VaccinationSupplyMovement[]

  @@unique([facilityId, sku])
  @@index([facilityId, active])
  @@map("vaccination_supplies")
}

/// Vínculo imunobiológico → insumos por dose — RF-14.4/14.6.
model VaccinationSupplyLink {
  id                 String @id @default(uuid())
  immunobiologicalId String @map("immunobiological_id")
  supplyId           String @map("supply_id")
  qtyPerDose         Int    @default(1) @map("qty_per_dose")
  active             Boolean @default(true)

  supply VaccinationSupply @relation(fields: [supplyId], references: [id])

  @@unique([immunobiologicalId, supplyId])
  @@index([immunobiologicalId])
  @@index([supplyId])
  @@map("vaccination_supply_links")
}

/// Movimentos de insumos vacinais (entrada, baixa aplicação, estorno void).
model VaccinationSupplyMovement {
  id                  String   @id @default(uuid())
  supplyId            String   @map("supply_id")
  /// ENTRY | APPLY | VOID_RETURN | ADJUST
  kind                String
  quantityDelta       Int      @map("quantity_delta")
  vaccinationRecordId String?  @map("vaccination_record_id")
  note                String?
  createdAt           DateTime @default(now()) @map("created_at")

  supply VaccinationSupply @relation(fields: [supplyId], references: [id])

  @@index([supplyId])
  @@index([vaccinationRecordId])
  @@index([kind])
  @@map("vaccination_supply_movements")
}

model ProductionBatch {
  id              String    @id @default(uuid())
  kind            String
  /// draft | ready | sent | error
  status          String    @default("draft")
  rfIdsCsv        String    @default("") @map("rf_ids_csv")
  payloadJson     String    @default("{}") @map("payload_json")
  /// Motivo do status error (ou último bloqueio no reprocessamento)
  errorMessage    String?   @map("error_message")
  statusChangedAt DateTime? @map("status_changed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([createdAt])
  @@map("production_batches")
}

/// Odontologia — atendimento clínico + rascunho LEDI FAO (RF-12.x)
model DentalEncounter {
  id                String    @id @default(uuid())
  patientId         String    @map("patient_id")
  facilityId        String    @map("facility_id")
  professionalId    String?   @map("professional_id")
  /// Lotação usada (CNS+CBO+CNES+INE)
  assignmentId      String?   @map("assignment_id")
  /// Slot de agenda que originou o atendimento (RF-12.1).
  /// @unique em optional: no PostgreSQL vários NULL são permitidos; só não-nulos são únicos.
  appointmentId     String?   @unique @map("appointment_id")
  encounterType     String    @default("CONSULTA") @map("encounter_type")
  /// IN_PROGRESS | COMPLETED | VOID
  status            String    @default("IN_PROGRESS")
  anamnese          String?
  /// JSON: [{ tooth?, region?, code, label, done }]
  proceduresJson    String    @default("[]") @map("procedures_json")
  /// JSON simplificado odontograma { "11": "C", ... }
  odontogramJson    String    @default("{}") @map("odontogram_json")
  outcomesJson      String    @default("[]") @map("outcomes_json")
  /// Rascunho clínico/LEDI enquanto OPEN (tipoAtendimento, vigilância, problemas, fornecimentos…)
  careJson          String    @default("{}") @map("care_json")
  startedAt         DateTime  @default(now()) @map("started_at")
  finishedAt        DateTime? @map("finished_at")
  productionBatchId String?   @map("production_batch_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  patient      Patient          @relation(fields: [patientId], references: [id])
  facility     Facility         @relation(fields: [facilityId], references: [id])
  professional Professional?    @relation(fields: [professionalId], references: [id])
  appointment  AppointmentSlot? @relation(fields: [appointmentId], references: [id])

  @@index([facilityId, status])
  @@index([patientId, facilityId, startedAt])
  @@map("dental_encounters")
}

/// Atenção domiciliar APS — ficha LEDI master/child 1–99 (RF-3.54)
model HomeCareVisit {
  id                String    @id @default(uuid())
  /// Paciente âncora (primeiro child); demais em childrenJson
  patientId         String    @map("patient_id")
  facilityId        String    @map("facility_id")
  professionalId    String?   @map("professional_id")
  careType          String    @default("AD1") @map("care_type")
  shift             String    @default("MANHA")
  status            String    @default("SCHEDULED")
  notes             String?
  proceduresJson    String    @default("[]") @map("procedures_json")
  /// JSON array de children LEDI (patientId + overrides por atendimento); máx. 99
  childrenJson      String    @default("[]") @map("children_json")
  visitedAt         DateTime  @default(now()) @map("visited_at")
  finishedAt        DateTime? @map("finished_at")
  productionBatchId String?   @map("production_batch_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  facility     Facility      @relation(fields: [facilityId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([facilityId, status])
  @@map("home_care_visits")
}

/// Atividade coletiva APS — stub MVP (RF-3.53)
model CollectiveActivity {
  id                String    @id @default(uuid())
  facilityId        String    @map("facility_id")
  professionalId    String?   @map("professional_id")
  teamId            String?   @map("team_id")
  /// EDUCACAO_SAUDE | REUNIAO | OUTRO
  activityType      String    @map("activity_type")
  /// Tema / prática em saúde (texto ou código catálogo)
  theme             String
  /// Público-alvo (texto ou código)
  audience          String
  shift             String    @default("MANHA")
  status            String    @default("DRAFT")
  participantCount  Int       @default(0) @map("participant_count")
  /// JSON array de patientIds (opcional, lista parcial)
  participantsJson  String    @default("[]") @map("participants_json")
  /// JSON array de procedimentos SIGTAP stub
  proceduresJson    String    @default("[]") @map("procedures_json")
  notes             String?
  heldAt            DateTime  @default(now()) @map("held_at")
  finishedAt        DateTime? @map("finished_at")
  productionBatchId String?   @map("production_batch_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  facility     Facility      @relation(fields: [facilityId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])

  @@index([facilityId, status])
  @@map("collective_activities")
}

/// Catálogo SIGTAP local (seed/import stub — não substitui tabela MS completa)
model SigtapProcedure {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  complex     String?  /// Atenção Básica / Média / Alta (texto livre stub)
  groupCode   String?  @map("group_code")
  groupName   String?  @map("group_name")
  active      Boolean  @default(true)
  source      String   @default("seed") /// seed | import
  competencia String?  /// YYYYMM da competência importada
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("sigtap_procedures")
}

/// Catálogo municipal mínimo de medicamentos (RF-2.11 / RF-3.33)
model Medication {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  activePrinciple String? @map("active_principle")
  form           String?  /// comprimido, xarope…
  concentration  String?
  /// ORAL | IM | IV | TOPICA | OUTRO
  defaultRoute   String?  @map("default_route")
  /// COMUM | ESPECIAL | CONTROLE
  recipeType     String   @default("COMUM") @map("recipe_type")
  controlled     Boolean  @default(false)
  active         Boolean  @default(true)
  source         String   @default("seed") /// seed | manual
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  items PrescriptionItem[]

  @@index([name])
  @@map("medications")
}

/// Prescrição / receituário APS (RF-3.33, RF-3.67)
model Prescription {
  id             String    @id @default(uuid())
  patientId      String    @map("patient_id")
  facilityId     String    @map("facility_id")
  professionalId String?   @map("professional_id")
  encounterId    String?   @map("encounter_id")
  /// DRAFT | ISSUED | CANCELLED
  status         String    @default("DRAFT")
  /// COMUM | ESPECIAL | CONTROLE
  recipeType     String    @default("COMUM") @map("recipe_type")
  notes          String?
  validUntil     DateTime? @map("valid_until")
  issuedAt       DateTime? @map("issued_at")
  /// alerta se algum item fora do catálogo municipal
  hasOffCatalog  Boolean   @default(false) @map("has_off_catalog")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  facility     Facility      @relation(fields: [facilityId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  encounter    Encounter?    @relation(fields: [encounterId], references: [id])
  items        PrescriptionItem[]

  @@index([patientId, createdAt])
  @@index([facilityId, status])
  @@index([encounterId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String  @id @default(uuid())
  prescriptionId String  @map("prescription_id")
  medicationId   String? @map("medication_id")
  /// Nome livre quando fora do padrão municipal
  freeTextName   String? @map("free_text_name")
  dose           String
  frequency      String
  duration       String?
  quantity       String?
  route          String?
  instructions   String?
  offCatalog     Boolean @default(false) @map("off_catalog")

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication?  @relation(fields: [medicationId], references: [id])

  @@map("prescription_items")
}

/// Complexo regulador (RF-2.3) — stub municipal
model RegulationComplex {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  /// MUNICIPAL | REGIONAL
  type      String   @default("MUNICIPAL")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("regulation_complexes")
}

/// Procedimentos pré-regulados / protocolo municipal (RF-13.2, RF-2.31 stub)
model RegulationProcedure {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  specialty   String?
  requiresCid Boolean  @default(false) @map("requires_cid")
  active      Boolean  @default(true)
  source      String   @default("seed")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([name])
  @@map("regulation_procedures")
}

/// Solicitação / demanda na central de regulação (RF-3.52, RF-13.*)
model RegulationRequest {
  id               String    @id @default(uuid())
  patientId        String    @map("patient_id")
  facilityId       String    @map("facility_id")
  professionalId   String?   @map("professional_id")
  encounterId      String?   @map("encounter_id")
  procedureCode    String    @map("procedure_code")
  procedureName    String    @map("procedure_name")
  /// true se código não está no catálogo pré-regulado
  offProtocol      Boolean   @default(false) @map("off_protocol")
  cid              String?
  clinicalSummary  String?   @map("clinical_summary")
  /// ELETIVO | PRIORITARIO | URGENTE
  priority         String    @default("ELETIVO")
  /// DRAFT | SUBMITTED | CLASSIFIED | AUTHORIZED | DENIED | RETURNED | SCHEDULED | CLOSED
  status           String    @default("DRAFT")
  /// VERDE | AMARELO | VERMELHO | AZUL (classificação reguladora)
  classification   String?
  denialReason     String?   @map("denial_reason")
  returnReason     String?   @map("return_reason")
  regulatorNotes   String?   @map("regulator_notes")
  scheduledHint    DateTime? @map("scheduled_hint")
  decidedAt        DateTime? @map("decided_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  patient      Patient       @relation(fields: [patientId], references: [id])
  facility     Facility      @relation(fields: [facilityId], references: [id])
  professional Professional? @relation(fields: [professionalId], references: [id])
  encounter    Encounter?    @relation(fields: [encounterId], references: [id])

  @@index([facilityId, status])
  @@index([patientId, createdAt])
  @@index([status, priority])
  @@index([encounterId])
  @@map("regulation_requests")
}

model AuditEvent {
  id            String   @id @default(uuid())
  action        String
  resourceType  String   @map("resource_type")
  resourceId    String   @map("resource_id")
  rfIdsCsv      String   @default("") @map("rf_ids_csv")
  detailJson    String   @default("{}") @map("detail_json")
  /// Ator autenticado (quando houver)
  userId        String?  @map("user_id")
  /// Correlation / request ID
  correlationId String?  @map("correlation_id")
  ip            String?
  /// success | failure | partial
  outcome       String   @default("success")
  at            DateTime @default(now())

  @@index([at])
  @@index([resourceType, resourceId])
  @@index([userId, at])
  @@index([correlationId])
  @@map("audit_events")
}

model Role {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  /// JSON array de chaves de permissão
  permissions String   @default("[]")
  createdAt   DateTime @default(now()) @map("created_at")
  users       User[]

  @@map("roles")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id")
  facilityId   String?  @map("facility_id")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role Role @relation(fields: [roleId], references: [id])

  @@map("users")
}

/// Lote de XMLs LEDI FAO para validação / correção (Siaps/RNDS)
model LediFaoBatch {
  id          String   @id @default(uuid())
  name        String
  /// uploaded | analyzed | partially_fixed | ready
  status      String   @default("uploaded")
  summaryJson String   @default("{}") @map("summary_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items LediFaoBatchItem[]

  @@index([createdAt])
  @@index([status])
  @@map("ledi_fao_batches")
}

model LediFaoBatchItem {
  id                 String   @id @default(uuid())
  batchId            String   @map("batch_id")
  fileName           String   @map("file_name")
  /// conformant | blocker | warn | fixed | error
  status             String   @default("blocker")
  /// Conteúdo inline (legado / lotes pequenos). Preferir object keys quando storage ativo.
  originalXml        String   @default("") @map("original_xml")
  currentXml         String   @default("") @map("current_xml")
  /// Chaves no Object Storage (S3-compatible)
  originalObjectKey  String?  @map("original_object_key")
  currentObjectKey   String?  @map("current_object_key")
  xmlSha256          String?  @map("xml_sha256")
  /// Optimistic locking
  version            Int      @default(1)
  findingsJson       String   @default("[]") @map("findings_json")
  /// Raio-x Previne ESB (JSON) — oportunidades de indicador/qualidade
  previneJson        String?  @map("previne_json")
  /// FAO | FAI | PROCEDIMENTOS | …
  fichaTipo          String?  @map("ficha_tipo")
  /// 5 | 4 | 7 | …
  fichaTipoCode      Int?     @map("ficha_tipo_code")
  masterJson         String?  @map("master_json")
  /// Códigos elegíveis a auto-correção neste item (CSV)
  autoFixableCodes   String   @default("") @map("auto_fixable_codes")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  batch LediFaoBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status])
  @@index([batchId, updatedAt])
  @@map("ledi_fao_batch_items")
}

/// Jobs assíncronos (fonte de verdade do status — Redis/BullMQ é broker)
model JobRun {
  id              String    @id @default(uuid())
  /// ledi.auto-fix | ledi.export-zip | sigtap.import | …
  type            String
  /// queued | active | completed | failed | dead
  status          String    @default("queued")
  idempotencyKey  String?   @unique @map("idempotency_key")
  correlationId   String?   @map("correlation_id")
  userId          String?   @map("user_id")
  /// Payload pequeno (refs S3 / IDs) — sem XML clínico completo
  payloadJson     String    @default("{}") @map("payload_json")
  resultJson      String?   @map("result_json")
  errorMessage    String?   @map("error_message")
  attempts        Int       @default(0)
  maxAttempts     Int       @default(5) @map("max_attempts")
  progressPct     Int       @default(0) @map("progress_pct")
  progressMessage String?   @map("progress_message")
  /// Object key do artefato (ZIP, relatório…)
  resultObjectKey String?   @map("result_object_key")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([type, status])
  @@index([correlationId])
  @@map("job_runs")
}

/// Identificadores vinculados ao Paciente Mestre (CPF, CNS, prontuário, temp LEDI…).
/// CPF/CNS em `patients` permanecem denormalizados para compat UI; esta tabela é a fonte de verdade.
model PatientIdentifier {
  id         String    @id @default(uuid())
  patientId  String    @map("patient_id")
  /// cpf | cns | prontuario_local | uuid_ledi | tmp_ledi | other
  system     String
  value      String
  /// official | secondary | temp | old
  use        String    @default("official")
  /// cadastro | ledi_xml | merge | manual | migration
  source     String    @default("cadastro")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([system, value])
  @@index([patientId])
  @@map("patient_identifiers")
}

/// Candidatos de unificação de pacientes (confiança HIGH/MEDIUM/LOW).
model PatientMatchCandidate {
  id              String    @id @default(uuid())
  leftPatientId   String    @map("left_patient_id")
  rightPatientId  String    @map("right_patient_id")
  /// HIGH | MEDIUM | LOW
  confidence      String
  score           Float     @default(0)
  /// auto_merged | pending_review | signal_only | rejected | merged_manual
  status          String    @default("signal_only")
  evidenceJson    String    @default("{}") @map("evidence_json")
  winnerPatientId String?   @map("winner_patient_id")
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedBy      String?   @map("reviewed_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  leftPatient   Patient  @relation("MatchLeft", fields: [leftPatientId], references: [id], onDelete: Cascade)
  rightPatient  Patient  @relation("MatchRight", fields: [rightPatientId], references: [id], onDelete: Cascade)
  winnerPatient Patient? @relation("MatchWinner", fields: [winnerPatientId], references: [id], onDelete: SetNull)

  @@index([status, confidence])
  @@index([leftPatientId, rightPatientId])
  @@map("patient_match_candidates")
}

/// Evento de auditoria do motor clínico (validate/repair/merge/migrate).
model ClinicalAuditEvent {
  id         String   @id @default(uuid())
  /// validate | repair | merge | migrate | export
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  payloadJson String  @default("{}") @map("payload_json")
  actorId    String?  @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@map("clinical_audit_events")
}

/**
 * Produção clínica persistida a partir de migração LEDI / atendimento nativo (A2).
 * Domínio Sigs* — não é o XML legado.
 */
model ProductionRecord {
  id              String   @id @default(uuid())
  patientId       String   @map("patient_id")
  /// FAO | FAI | PROCEDIMENTOS | NATIVE
  fichaTipo       String   @map("ficha_tipo")
  uuidFicha       String?  @map("uuid_ficha")
  facilityCnes    String?  @map("facility_cnes")
  professionalCns String?  @map("professional_cns")
  cbo             String?
  ine             String?
  periodStart     DateTime? @map("period_start")
  periodEnd       DateTime? @map("period_end")
  /// JSON SigsEncounter (FHIR-like)
  encounterJson   String   @map("encounter_json")
  /// XML origem (opcional, auditoria/migração)
  sourceXml       String?  @map("source_xml")
  /// migration | native | ledi_batch
  source          String   @default("migration")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([uuidFicha])
  @@index([patientId, fichaTipo])
  @@index([facilityCnes, periodStart])
  @@map("production_records")
}
