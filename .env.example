# Exemplo de variáveis — copie para .env / painel Coolify / Railway

# API
PORT=3001
DATABASE_URL=postgresql://sigs:sigs@localhost:5432/sigs?schema=public
JWT_SECRET=troque-em-producao
CORS_ORIGIN=http://localhost:3000
SEED_ADMIN_EMAIL=admin@sigs.local
SEED_ADMIN_PASSWORD=admin123
HTTP_BODY_LIMIT=20mb

# Redis (BullMQ). Sem REDIS_URL = jobs inline no processo da API (dev).
REDIS_URL=redis://localhost:6379

# Object Storage S3-compatible (MinIO/R2/S3). Sem S3_* = disco local tmp/storage.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sigs
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
# STORAGE_LOCAL_PATH=./tmp/storage
# Odontologia clínica
# REQUIRE_INE_DENTAL_OPEN=true   # Franca: true; outras cidades: false
# DENTAL_DEFAULT_TIPO_ATENDIMENTO=5
# DENTAL_DEFAULT_LOCAL=1
# DENTAL_DEFAULT_TURNO=2
# MUNICIPIO_IBGE=3516200

# Worker
# WORKER_CONCURRENCY=2
# PROCESS_ROLE=api|worker|web|all

# Web (build-time no Next: NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Docker Compose / Coolify / Railway
# JWT_SECRET=string-longa-aleatoria
# CORS_ORIGIN=https://seu-dominio
# NEXT_PUBLIC_API_URL=https://api.seu-dominio/api
# DATABASE_URL=postgresql://user:pass@host:5432/sigs
# REDIS_URL=redis://host:6379
